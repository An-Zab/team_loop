# Strata team_loop — ШАГ 1 (team_config.py)
# Скопируйте этот файл в .env и при необходимости поправьте значения.
# Все переменные необязательны: без .env работают дефолты из team_config.py.
#
# КОДИРОВКА .env (Windows): сохраните файл в UTF-8 (BOM не обязателен) или в
# UTF-16 с BOM. Файл в другой кодировке (CP1251) модуль не угадывает: он
# пишет предупреждение в stderr и работает на дефолтах. Учтите, что в Windows
# PowerShell 5.1 `echo "K=v" > .env` создаёт UTF-16, а не UTF-8; для UTF-8
# берите `Out-File -Encoding utf8` или редактор с выбором кодировки.

# --- Подключение к локальной модели ---
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=EMPTY
MODEL_NAME=qwen-local

# --- Контекст и Handoff (переопределение по желанию) ---
# MAX_CONTEXT_TOKENS=32768
# HANDOFF_FREE_RATIO=0.25
# HANDOFF_TOKEN_LIMIT=24576   # должно быть в диапазоне 1..MAX_CONTEXT_TOKENS
# MAX_STEP_ATTEMPTS=3
#
# Делитель запасной оценки токенов (len(text) // N), когда сервер не вернул
# usage. 3 — по ТЗ; для преимущественно кириллического контекста реалистичнее
# 2, иначе Handoff срабатывает позже реального заполнения окна.
# TOKEN_ESTIMATE_DIVISOR=3
#
# Файлы состояния Handoff. Относительный путь отсчитывается от каталога
# модуля (корня проекта), а не от текущего каталога процесса, поэтому
# `--resume` найдёт handoff.md, из какого бы cwd его ни запустили.
# HANDOFF_FILE=handoff.md
# HANDOFF_BACKUP=handoff.bak
